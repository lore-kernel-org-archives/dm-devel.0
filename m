diff --git a/libmultipath/udevrule.c b/libmultipath/udevrule.c
new file mode 100644
index 00000000..e927bf9a
--- /dev/null
+++ b/libmultipath/udevrule.c
@@ -0,0 +1,191 @@
+/*
+ * udevrule.c
+ *
+ * Copyright (c) 2017 Guan Junxiong <guanjunxiong@huawei.com>, Huawei
+ *
