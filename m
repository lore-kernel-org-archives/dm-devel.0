 configure                 | 36 +++++++++++++++++++++++++++++++++---
 configure.ac              | 28 +++++++++++++++++++++++++---
 include/configure.h.in    |  3 +++
 lib/misc/lib.h            | 10 +++++-----
 libdm/datastruct/bitset.c |  5 +----
 libdm/ioctl/libdm-iface.c |  2 +-
