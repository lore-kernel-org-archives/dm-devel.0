> +	my $text = shift;
> +	if (($output_mode eq "text") || ($output_mode eq "man")) {
> +		return $text;
> +	}
> +	$text =~ s/\\\\\\\\lt:/</g;
> +	$text =~ s/\\\\\\\\gt:/>/g;
> +	return $text;
> +}
